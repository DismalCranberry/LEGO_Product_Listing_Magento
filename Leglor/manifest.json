{
  "manifest_version": 3,
  "name": "Dormant LEGO Content Hub",
  "version": "1.4.7",
  "action": {
    "default_title": "Hub LEGO content",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/bricked128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "icons": {
    "128": "icons/bricked128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://content.lego.com/*",
    "https://lac-bucket-assets-prod.s3.eu-west-1.amazonaws.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://content.lego.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
