{
  "manifest_version": 3,
  "name": "Dormant LEGO Content Scraper",
  "version": "1.3.0",
  "action": {
    "default_title": "Scrape LEGO content",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/bricked128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "icons": {
    "128": "icons/bricked128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://content.lego.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://content.lego.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
